---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/logos/Wordmark.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, getSettings } from '../lib/content';

// The only page published until "Site is live" is ticked in Keystatic's Site settings.
const landing = await reader.singletons.landing.readOrThrow();
const settings = await getSettings();
const year = new Date().getFullYear();
// Each line of the intro is its own paragraph
const intro = (landing.text ?? '').split(/\n+/).map((line) => line.trim()).filter(Boolean);
---

<Layout title={landing.seo.title} description={landing.seo.description} bare>
	{/* The --v* steps scale with the screen's height, so the whole form fits on one screen
	     from short laptops up to large monitors */}
	<div
		class="bg-espresso on-dark grid min-h-svh grid-cols-[5fr_6fr] max-desk:grid-cols-1
			[--v1:clamp(0.4rem,1.4svh,1rem)] [--v2:clamp(0.6rem,2.2svh,1.5rem)]
			[--v3:clamp(0.9rem,3.6svh,2.5rem)] [--v4:clamp(1.1rem,4.5svh,3.5rem)]"
	>
		{/* On phones a short band, so the form starts high enough to fit below it */}
		<div
			class="media relative overflow-hidden bg-espresso max-desk:h-[clamp(8rem,24svh,18rem)]
				max-desk:[@media(max-height:720px)]:h-[11svh]"
		>
			{/* Heavily blurred so the products only hint at themselves before launch. Oversized so
			     the blur's soft edges fall outside the frame. */}
			{landing.image && (
				<img
					class="absolute -inset-[10%] h-[120%] w-[120%] object-cover object-[30%_50%]
						[filter:blur(14px)_saturate(0.8)_brightness(0.92)] max-desk:object-[40%_25%]"
					src={landing.image}
					alt=""
					width="1024"
					height="1536"
					fetchpriority="high"
				/>
			)}
			{/* The one sharp thing on the photo: the monogram, centred over the blur */}
			<Monogram
				class="absolute top-1/2 left-1/2 z-1 h-auto w-[clamp(4.5rem,9vw,7rem)] -translate-1/2 text-mineral
					drop-shadow-[0_2px_18px_rgb(61_47_48/0.5)] max-desk:w-[clamp(2.5rem,8svh,5rem)]"
			/>
		</div>

		<div class="grid grid-rows-[auto_1fr_auto] gap-(--v3) px-gutter py-(--v3)">
			<Wordmark class="h-auto w-[clamp(6rem,min(12vw,16svh),9.5rem)] max-desk:[@media(max-height:720px)]:w-20" />

			<div class="grid max-w-xl content-center gap-(--v4)">
				<div class="stack gap-(--v2)">
					{landing.eyebrow && <p class="label bracket text-ink-muted">{landing.eyebrow}</p>}
					<h1
						class="text-[length:clamp(1.6rem,min(3.6vw,5.6svh),3.25rem)]
							max-desk:[@media(max-height:720px)]:text-[length:clamp(1.4rem,4.6svh,2rem)]"
					>
						{landing.heading}
					</h1>
					{intro.map((text) => (
						<p
							class="lede text-ink-muted text-[length:clamp(0.8125rem,min(1.1vw,1.9svh),0.9688rem)] leading-[1.7]
								max-desk:text-[length:clamp(0.75rem,1.9svh,0.875rem)] max-desk:leading-[1.6]"
						>
							{text}
						</p>
					))}
				</div>

				<form
					class="grid gap-(--v2)"
					id="landing-signup"
					data-klaviyo-key={settings.klaviyo.publicKey}
					data-klaviyo-list={settings.klaviyo.listId}
					data-source="Landing page"
				>
					<div class="grid grid-cols-2 gap-x-6 gap-y-(--v1) max-[341px]:grid-cols-1">
						<div class="field gap-1">
							<label class="label text-ink-muted" for="landing-first-name">First name</label>
							<input class="py-[clamp(0.35rem,1.1svh,0.9rem)]" id="landing-first-name" name="firstName" type="text" required autocomplete="given-name" />
						</div>
						<div class="field gap-1">
							<label class="label text-ink-muted" for="landing-last-name">Last name</label>
							<input class="py-[clamp(0.35rem,1.1svh,0.9rem)]" id="landing-last-name" name="lastName" type="text" required autocomplete="family-name" />
						</div>
						<div class="field col-span-full gap-1">
							<label class="label text-ink-muted" for="landing-email">Email</label>
							<input class="py-[clamp(0.35rem,1.1svh,0.9rem)]" id="landing-email" name="email" type="email" required autocomplete="email" />
						</div>
					</div>
					<button class="btn btn--light min-h-[clamp(2.75rem,6svh,3.5rem)] w-full" type="submit">{landing.buttonLabel || 'Join'}</button>
					<p class="label text-center" id="landing-error" role="alert" hidden>
						Something went wrong. Please try again{settings.email && `, or email us at ${settings.email}`}.
					</p>
					{landing.note && <p class="label text-center text-ink-muted">{landing.note}</p>}
				</form>

				<p class="text-h3 border-y border-rule py-6" id="landing-thanks" role="status" hidden>Thank you. You're on the list.</p>
			</div>

			<div class="label flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-rule pt-(--v2) text-ink-muted">
				<Monogram class="h-auto w-[1.1rem]" />
				<ul class="mr-auto flex flex-wrap gap-6">
					{settings.instagram && <li><a class="hover:text-mineral" href={settings.instagram} rel="noopener">Instagram</a></li>}
					{settings.email && <li><a class="hover:text-mineral" href={`mailto:${settings.email}`}>{settings.email}</a></li>}
				</ul>
				<span>© {year} Elyon Labs</span>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { handleSignup } from '../lib/subscribe';

	const form = document.querySelector<HTMLFormElement>('#landing-signup');
	const thanks = document.querySelector<HTMLElement>('#landing-thanks');
	const error = document.querySelector<HTMLElement>('#landing-error');

	if (form) {
		handleSignup(form, {
			onSuccess: () => {
				form.hidden = true;
				if (thanks) thanks.hidden = false;
			},
			onError: () => {
				if (error) error.hidden = false;
			},
		});
	}
</script>

<style>
	/* Espresso vignette over the blurred photo: deepens the edges and melts it into the panel
	   beside it (desktop) or below it (phones) */
	.media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 70% 60% at 45% 45%, rgb(61 47 48 / 0) 0%, rgb(61 47 48 / 0.5) 100%),
			linear-gradient(to right, rgb(61 47 48 / 0) 60%, var(--espresso) 100%);
	}

	@media (max-width: 960px) {
		.media::after {
			background:
				radial-gradient(ellipse 70% 60% at 50% 45%, rgb(61 47 48 / 0) 0%, rgb(61 47 48 / 0.5) 100%),
				linear-gradient(to bottom, rgb(61 47 48 / 0) 55%, var(--espresso) 100%);
		}
	}
</style>
