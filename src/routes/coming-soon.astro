---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/logos/Wordmark.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, getSettings } from '../lib/content';

// The only page published until "Site is live" is ticked in Keystatic's Site settings.
const landing = await reader.singletons.landing.readOrThrow();
const settings = await getSettings();
const year = new Date().getFullYear();
---

<Layout title={landing.seo.title} description={landing.seo.description} bare>
	<div class="landing bg-espresso on-dark">
		<div class="media">
			{landing.image && <img src={landing.image} alt="" width="1024" height="1536" fetchpriority="high" />}
			<Monogram class="media-mark" />
		</div>

		<div class="panel">
			<Wordmark class="landing-wordmark" />

			<div class="content">
				<div class="stack">
					{landing.eyebrow && <p class="label bracket muted">{landing.eyebrow}</p>}
					<h1 class="display">{landing.heading}</h1>
					{landing.text && <p class="lede muted">{landing.text}</p>}
				</div>

				<form
					class="signup"
					id="landing-signup"
					data-klaviyo-key={settings.klaviyo.publicKey}
					data-klaviyo-list={settings.klaviyo.listId}
					data-source="Landing page"
				>
					<div class="fields">
						<div class="field">
							<label class="label muted" for="landing-first-name">First name</label>
							<input id="landing-first-name" name="firstName" type="text" required autocomplete="given-name" />
						</div>
						<div class="field">
							<label class="label muted" for="landing-last-name">Last name</label>
							<input id="landing-last-name" name="lastName" type="text" required autocomplete="family-name" />
						</div>
						<div class="field field--full">
							<label class="label muted" for="landing-email">Email</label>
							<input id="landing-email" name="email" type="email" required autocomplete="email" />
						</div>
					</div>
					<button class="btn btn--light submit" type="submit">{landing.buttonLabel || 'Join'}</button>
					<p class="label error" id="landing-error" role="alert" hidden>
						Something went wrong. Please try again{settings.email && `, or email us at ${settings.email}`}.
					</p>
					{landing.note && <p class="label muted note">{landing.note}</p>}
				</form>

				<p class="thanks h3" id="landing-thanks" role="status" hidden>Thank you. You're on the list.</p>
			</div>

			<div class="base label muted">
				<Monogram class="landing-mark" />
				<ul>
					{settings.instagram && <li><a href={settings.instagram} rel="noopener">Instagram</a></li>}
					{settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
				</ul>
				<span>© {year} Elyon Labs</span>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { handleSignup } from '../lib/subscribe';

	const form = document.querySelector<HTMLFormElement>('#landing-signup');
	const thanks = document.querySelector<HTMLElement>('#landing-thanks');
	const error = document.querySelector<HTMLElement>('#landing-error');

	if (form) {
		handleSignup(form, {
			onSuccess: () => {
				form.hidden = true;
				if (thanks) thanks.hidden = false;
			},
			onError: () => {
				if (error) error.hidden = false;
			},
		});
	}
</script>

<style>
	.landing {
		/* Vertical rhythm scales with the screen's height, so the whole form fits on one
		   screen from short laptops up to large monitors */
		--v1: clamp(0.4rem, 1.4svh, 1rem);
		--v2: clamp(0.6rem, 2.2svh, 1.5rem);
		--v3: clamp(0.9rem, 3.6svh, 2.5rem);
		--v4: clamp(1.1rem, 4.5svh, 3.5rem);
		display: grid;
		grid-template-columns: 5fr 6fr;
		min-height: 100svh;
	}

	.media {
		position: relative;
		background: var(--espresso);
		overflow: hidden;
	}

	/* Heavily blurred so the products only hint at themselves before launch. Oversized so
	   the blur's soft edges fall outside the frame. */
	.media img {
		position: absolute;
		inset: -10%;
		width: 120%;
		height: 120%;
		object-fit: cover;
		object-position: 30% 50%;
		filter: blur(14px) saturate(0.8) brightness(0.92);
	}

	/* Espresso vignette: deepens the edges and melts the photo into the panel beside it */
	.media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 70% 60% at 45% 45%, rgb(61 47 48 / 0) 0%, rgb(61 47 48 / 0.5) 100%),
			linear-gradient(to right, rgb(61 47 48 / 0) 60%, var(--espresso) 100%);
	}

	/* The one sharp thing on the photo: the monogram, centred over the blur */
	:global(.media-mark) {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		width: clamp(4.5rem, 9vw, 7rem);
		height: auto;
		color: var(--mineral);
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 2px 18px rgb(61 47 48 / 0.5));
	}

	.panel {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: var(--v3);
		padding: var(--v3) var(--gutter);
	}

	:global(.landing-wordmark) {
		width: clamp(6rem, min(12vw, 16svh), 9.5rem);
		height: auto;
	}

	.content {
		display: grid;
		gap: var(--v4);
		align-content: center;
		max-width: 36rem;
	}

	.content .stack {
		gap: var(--v2);
	}

	.content .display {
		font-size: clamp(1.6rem, min(3.6vw, 5.6svh), 3.25rem);
	}

	.content .lede {
		font-size: clamp(0.8125rem, min(1.1vw, 1.9svh), 0.9688rem);
		line-height: 1.7;
	}

	.signup {
		display: grid;
		gap: var(--v2);
	}

	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--v1) var(--space-3);
	}

	.fields .field {
		gap: 0.25rem;
	}

	.fields input {
		padding-block: clamp(0.35rem, 1.1svh, 0.9rem);
	}

	.field--full {
		grid-column: 1 / -1;
	}

	.submit {
		width: 100%;
		min-height: clamp(2.75rem, 6svh, 3.5rem);
	}

	.note,
	.error {
		text-align: center;
	}

	.thanks {
		padding-block: var(--space-3);
		border-block: 1px solid var(--rule);
	}

	.base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		padding-top: var(--v2);
		border-top: 1px solid var(--rule);
	}

	.base ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: 0 auto 0 0;
		padding: 0;
		list-style: none;
	}

	.base a {
		text-decoration: none;
	}

	.base a:hover {
		color: var(--mineral);
	}

	:global(.landing-mark) {
		width: 1.1rem;
		height: auto;
	}

	@media (max-width: 960px) {
		.landing {
			grid-template-columns: 1fr;
		}

		/* A short band, so the form starts high enough to fit below it */
		.media {
			height: clamp(8rem, 24svh, 18rem);
		}

		/* Keeps the bottle caps in the crop */
		.media img {
			object-position: 40% 25%;
		}

		/* The photo sits above the panel on phones, so it melts downwards instead */
		.media::after {
			background:
				radial-gradient(ellipse 70% 60% at 50% 45%, rgb(61 47 48 / 0) 0%, rgb(61 47 48 / 0.5) 100%),
				linear-gradient(to bottom, rgb(61 47 48 / 0) 55%, var(--espresso) 100%);
		}

		:global(.media-mark) {
			width: clamp(2.5rem, 8svh, 5rem);
		}

		.content .lede {
			font-size: clamp(0.75rem, 1.9svh, 0.875rem);
			line-height: 1.6;
		}
	}

	/* Short phones (e.g. iPhone SE): squeeze the photo band and wordmark so the form still fits */
	@media (max-width: 960px) and (max-height: 720px) {
		.media {
			height: 16svh;
		}

		:global(.landing-wordmark) {
			width: 5rem;
		}

		.content .display {
			font-size: clamp(1.4rem, 4.6svh, 2rem);
		}
	}

	@media (max-width: 340px) {
		.fields {
			grid-template-columns: 1fr;
		}
	}
</style>
