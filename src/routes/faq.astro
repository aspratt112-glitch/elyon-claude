---
import Layout from '../layouts/Layout.astro';
import { reader, paragraphs } from '../lib/content';

const faq = await reader.singletons.faq.readOrThrow();
---

<Layout title={faq.seo.title} description={faq.seo.description}>
	<div class="wrap grid grid-cols-[1fr_1.4fr] gap-[clamp(2rem,6vw,6rem)] pb-section max-desk:grid-cols-1 max-desk:gap-0">
		<header class="page-head sticky top-20 self-start max-desk:static">
			<p class="label bracket text-ink-muted">{faq.eyebrow}</p>
			<h1 class="text-display">{faq.heading}</h1>
			<p class="lede text-ink-muted">{faq.intro}</p>
			<a class="link-arrow" href="/contact">Ask us directly</a>
		</header>

		<div class="grid gap-space-5 pt-space-6 max-desk:pt-0">
			{faq.groups.map((group) => (
				<section>
					<h2 class="label bracket mb-4 text-ink-muted">{group.title}</h2>
					{group.items.map((item) => (
						<details class="border-t border-rule last:border-b">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-8 py-6 [&::-webkit-details-marker]:hidden">
								<span class="text-[length:clamp(1.05rem,1.6vw,1.3rem)]">{item.question}</span>
								<span class="icon relative size-[14px] flex-none" aria-hidden="true"></span>
							</summary>
							<div class="prose pb-7 font-mono text-sm leading-[1.75] font-light">
								{paragraphs(item.answer).map((p) => <p>{p}</p>)}
							</div>
						</details>
					))}
				</section>
			))}
		</div>
	</div>
</Layout>

<style>
	/* A plus that turns into a minus as the answer opens */
	.icon::before,
	.icon::after {
		content: '';
		position: absolute;
		inset: 6px 0 auto 0;
		height: 1.5px;
		background: currentColor;
		transition: transform 0.2s;
	}

	.icon::after {
		transform: rotate(90deg);
	}

	details[open] .icon::after {
		transform: rotate(0deg);
	}
</style>
