---
import Layout from '../layouts/Layout.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, stepNumber } from '../lib/content';

const mission = await reader.singletons.mission.readOrThrow();
---

<Layout title={mission.seo.title} description={mission.seo.description}>
	<section class="bg-espresso on-dark">
		<div class="wrap grid grid-cols-2 items-end gap-space-5 py-space-6 max-nav:grid-cols-1">
			<div class="stack">
				<p class="label bracket text-ink-muted">{mission.eyebrow}</p>
				<h1 class="text-display">{mission.heading}</h1>
			</div>
			<p class="max-w-[34ch] text-[length:clamp(1.15rem,1.9vw,1.6rem)] leading-[1.4] text-ink-muted">{mission.mission}</p>
		</div>
	</section>

	<section class="py-section">
		<div class="wrap grid grid-cols-[5fr_7fr] items-center gap-space-6 max-nav:grid-cols-1 max-nav:gap-10">
			<div class="frame aspect-4/5">
				{mission.image && <img src={mission.image} alt="" loading="lazy" width="1203" height="1523" />}
			</div>
			<div class="stack gap-10">
				<p class="label bracket text-ink-muted">Vision</p>
				<p class="max-w-[32ch] text-[length:clamp(1.25rem,2.2vw,1.85rem)] leading-[1.4]">{mission.vision}</p>
			</div>
		</div>
	</section>

	<section class="border-t border-rule py-section">
		<div class="wrap">
			<div class="stack mb-space-5">
				<p class="label bracket text-ink-muted">Values</p>
				<h2 class="text-h2">{mission.valuesHeading}</h2>
			</div>
			<ol>
				{mission.values.map((value, i) => (
					<li
						class="grid grid-cols-[2fr_5fr_5fr] items-baseline gap-6 border-t border-rule py-10 last:border-b
							max-nav:grid-cols-1 max-nav:gap-2"
					>
						<span class="label bracket text-ink-muted">{stepNumber(i + 1)}</span>
						<h3 class="text-[length:clamp(1.3rem,2.2vw,1.85rem)] leading-[1.25]">{value.title}</h3>
						<p class="mono max-w-[52ch]">{value.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section>
		<div class="wrap grid justify-items-center gap-10 pb-section text-center">
			<Monogram class="h-auto w-10" />
			<p class="text-h2 max-w-[26ch]">{mission.promise}</p>
		</div>
	</section>
</Layout>
