---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, paragraphs, stepNumber, type Product } from '../../lib/content';

export async function getStaticPaths() {
	const products = await getProducts();
	return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
	product: Product;
}

const { product } = Astro.props;
const others = (await getProducts()).filter((p) => p.slug !== product.slug);
const comingSoon = product.status === 'coming-soon';

const specs = [
	{ label: 'Step', value: `${stepNumber(product.step)} / ${product.stepLabel}` },
	{ label: 'Size', value: product.size || 'To be confirmed' },
	{ label: 'Price', value: product.price || 'To be confirmed' },
	{ label: 'Status', value: comingSoon ? 'Coming soon' : 'Available' },
];
---

<Layout title={`${product.name} | Elyon`} description={product.seoDescription || product.summary}>
	<div class="wrap label flex gap-4 py-6 text-ink-muted">
		<a class="hover:text-ink" href="/#system">The System</a>
		<span aria-hidden="true">/</span>
		<span class="text-ink" aria-current="page">{product.name}</span>
	</div>

	<section class="wrap grid grid-cols-[7fr_5fr] items-start gap-space-6 pb-section max-desk:grid-cols-1 max-desk:gap-10">
		<div class="frame sticky top-26 aspect-4/5 max-desk:static">
			{product.image && <img src={product.image} alt={product.name} width="1200" height="1500" fetchpriority="high" />}
		</div>

		<div class="grid justify-items-start gap-10 pt-10 max-desk:pt-0">
			<div class="stack">
				<p class="label bracket text-ink-muted">{stepNumber(product.step)}&nbsp;&nbsp;{product.stepLabel}</p>
				<h1 class="text-display">{product.name}</h1>
				<p class="label bracket text-ink-muted">{product.keyNotes}</p>
			</div>
			<p class="lede">{product.summary}</p>

			<dl class="w-full border-t border-rule">
				{specs.map((spec) => (
					<div class="grid grid-cols-[8rem_1fr] items-baseline border-b border-rule py-4">
						<dt class="label text-ink-muted">{spec.label}</dt>
						<dd class="text-[0.9375rem]">{spec.value}</dd>
					</div>
				))}
			</dl>

			{comingSoon ? (
				<a class="btn" href="#newsletter">Notify me at launch</a>
			) : (
				<a class="btn" href="/contact">Enquire to order</a>
			)}

			<div class="prose border-t border-rule pt-10">
				{paragraphs(product.description).map((p) => <p>{p}</p>)}
			</div>
		</div>
	</section>

	<section class="border-t border-rule py-section">
		<div class="wrap grid grid-cols-3 gap-space-5 max-desk:grid-cols-1">
			{product.benefits.length > 0 && (
				<div class="grid content-start gap-10">
					<h2 class="label bracket border-b border-rule-strong pb-4 text-ink-muted">What it does</h2>
					<ul class="grid gap-4">
						{product.benefits.map((b) => (
							<li class="grid grid-cols-[1.75rem_1fr] before:font-mono before:text-ink-muted before:content-['+']">{b}</li>
						))}
					</ul>
				</div>
			)}

			{product.ingredients.length > 0 && (
				<div class="grid content-start gap-10">
					<h2 class="label bracket border-b border-rule-strong pb-4 text-ink-muted">Key ingredients</h2>
					<dl class="grid gap-6">
						{product.ingredients.map((ing) => (
							<div class="grid gap-2 border-b border-rule pb-6 last:border-b-0 last:pb-0">
								<dt class="text-[1rem] leading-[1.25]">{ing.title}</dt>
								<dd class="mono">{ing.text}</dd>
							</div>
						))}
					</dl>
				</div>
			)}

			<div class="grid content-start gap-10">
				<h2 class="label bracket border-b border-rule-strong pb-4 text-ink-muted">How to use</h2>
				<div class="prose">
					{paragraphs(product.howToUse).map((p) => <p>{p}</p>)}
				</div>
				<dl class="grid gap-6 border-t border-rule pt-6">
					{product.texture && (
						<div class="grid gap-2">
							<dt class="label text-ink-muted">Texture &amp; finish</dt>
							<dd class="mono">{product.texture}</dd>
						</div>
					)}
					{product.freeFrom && (
						<div class="grid gap-2">
							<dt class="label text-ink-muted">Free from</dt>
							<dd class="mono">{product.freeFrom}</dd>
						</div>
					)}
				</dl>
			</div>
		</div>
	</section>

	<section class="border-t border-rule py-section">
		<div class="wrap">
			<div class="stack mb-space-5">
				<p class="label bracket text-ink-muted">Complete the system</p>
				<h2 class="text-h2">Three products. One system.</h2>
			</div>
			<div class="grid max-w-[960px] grid-cols-2 gap-10 max-desk:grid-cols-1">
				{others.map((p) => <ProductCard product={p} />)}
			</div>
		</div>
	</section>
</Layout>
