---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Monogram from '../components/logos/Monogram.astro';
import SignupPopup from '../components/SignupPopup.astro';
import { reader, getProducts } from '../lib/content';

const home = await reader.singletons.home.readOrThrow();
const products = await getProducts();
---

<Layout title={home.seo.title} description={home.seo.description} overlayHeader>
	{/* Full-bleed banner that runs up behind the transparent menu */}
	<section
		class="on-dark relative -mt-[calc(var(--header-h)+1px)] grid min-h-[min(100svh,1000px)] items-end overflow-hidden bg-espresso
			max-desk:min-h-[min(100svh,760px)]"
		data-header-overlay
	>
		<div class="hero-media absolute inset-0">
			{/* Anchored to the bottom so the ELYON on the bottle sits as high as the crop allows */}
			{home.hero.image && (
				<img
					class="size-full object-cover object-[70%_100%] max-desk:object-[72%_50%]"
					src={home.hero.image}
					alt=""
					width="2400"
					height="1350"
					fetchpriority="high"
				/>
			)}
		</div>
		<div class="wrap relative grid justify-items-start gap-6 pt-[calc(var(--header-h)+var(--space-6))] pb-space-5">
			{home.hero.eyebrow && <p class="label bracket">{home.hero.eyebrow}</p>}
			{/* A quieter headline on desktop; mobile keeps the standard display size */}
			<h1 class="text-display max-w-[20ch] desk:text-[length:clamp(2.5rem,3.6vw,3.25rem)]">{home.hero.heading}</h1>
			<div class="mt-6 grid w-[min(100%,34rem)] justify-items-start gap-10 border-t border-rule pt-10">
				<p class="lede text-ink-muted">{home.hero.text}</p>
				<a class="btn btn--light" href="#system">{home.hero.ctaLabel}</a>
			</div>
		</div>
	</section>

	{/* Hands its bottom spacing to the pillars' fade-in below */}
	<section class="pt-section pb-space-5" id="system">
		<div class="wrap">
			<div class="grid grid-cols-2 items-end gap-x-space-5 gap-y-10 max-desk:grid-cols-1">
				<div class="stack">
					<p class="label bracket text-ink-muted">{home.system.eyebrow}</p>
					<h2 class="text-h2">{home.system.heading}</h2>
				</div>
				<p class="lede text-ink-muted">{home.system.text}</p>
			</div>
			<div class="mt-space-5 grid grid-cols-3 gap-10 max-desk:grid-cols-1 max-desk:gap-space-5">
				{products.map((product) => <ProductCard product={product} />)}
			</div>
		</div>
	</section>

	<section class="pillars on-dark">
		<div class="wrap">
			<div class="grid grid-cols-3 border-y border-rule max-desk:grid-cols-1">
				{home.pillars.map((pillar) => (
					<article
						class="stack border-l border-rule px-10 py-space-5 first:border-l-0 first:pl-0 last:pr-0
							max-desk:border-t max-desk:border-l-0 max-desk:px-0 max-desk:py-10 max-desk:first:border-t-0"
					>
						<h3 class="text-h3">{pillar.title}</h3>
						<p class="mono max-w-[38ch]">{pillar.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	{/* Overlaps by 1px so sub-pixel rounding can't open a seam with the gradient above */}
	<section class="statement on-dark relative -mt-px grid min-h-[min(72vh,760px)] overflow-hidden bg-espresso">
		{/* Background video (or still): its brightness is kept but the colour comes from the Espresso
		    underneath, so the footage sits in the brand palette. It fades in from plain Espresso so
		    there's no seam with the section above. */}
		{home.statement.video ? (
			<video
				class="statement-bg absolute inset-0 size-full object-cover opacity-55 mix-blend-luminosity
					[mask-image:linear-gradient(to_bottom,transparent_0%,#000_45%)]"
				src={home.statement.video}
				poster={home.statement.image ?? undefined}
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				aria-hidden="true"
			/>
		) : (
			// The fallback still is low resolution, so it's softened into texture
			home.statement.image && (
				<img
					class="absolute -inset-3 h-[calc(100%+24px)] w-[calc(100%+24px)] object-cover opacity-22 mix-blend-luminosity
						[filter:blur(3px)_saturate(0.6)] [mask-image:linear-gradient(to_bottom,transparent_0%,#000_45%)]"
					src={home.statement.image}
					alt=""
					loading="lazy"
				/>
			)
		)}
		<div class="wrap relative z-1 grid place-content-center justify-items-center gap-10 py-space-6 text-center">
			<Monogram class="h-auto w-10" />
			<p class="text-h2 max-w-[18ch]">{home.statement.text}</p>
		</div>
	</section>

	<section class="py-section">
		<div class="wrap grid grid-cols-[7fr_5fr] items-center gap-space-6 max-desk:grid-cols-1 max-desk:gap-10">
			<div class="frame aspect-3/2">
				{home.story.image && <img src={home.story.image} alt="" loading="lazy" width="1200" height="800" />}
			</div>
			<div class="stack gap-6">
				<p class="label bracket text-ink-muted">{home.story.eyebrow}</p>
				<h2 class="text-h2">{home.story.heading}</h2>
				<p class="lede text-ink-muted">{home.story.text}</p>
				<a class="link-arrow mt-4" href="/story">Read our story</a>
			</div>
		</div>
	</section>

	{home.popup.enabled && <SignupPopup {...home.popup} />}
</Layout>

<script>
	// Respect reduced-motion settings: hold the band on its first frame instead of looping.
	const video = document.querySelector<HTMLVideoElement>('video.statement-bg');
	if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.removeAttribute('autoplay');
		video.pause();
	}
</script>

<style>
	/* Darkens the top (for the menu) and the left (for the copy); the bottom stays light
	   on the right so the bottle's ELYON lettering isn't shaded out */
	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgb(61 47 48 / 0.6) 0%, rgb(61 47 48 / 0) 28%),
			linear-gradient(to top, rgb(61 47 48 / 0.3) 0%, rgb(61 47 48 / 0) 35%),
			linear-gradient(to right, rgb(61 47 48 / 0.7) 0%, rgb(61 47 48 / 0.35) 40%, rgb(61 47 48 / 0) 60%);
	}

	/* Moss at 80% (#63655a): fades in from Mineral White, then eases into Espresso so it
	   runs straight into the statement band. The fades sit in the padding, so text only
	   ever sits on solid Moss. Only full Mineral White passes AA on this tint (5.3:1). */
	.pillars {
		--moss-80: #63655a;
		--fade-in: calc(var(--section) * 1.1);
		--ink-muted: var(--mineral);
		padding-block: calc(var(--fade-in) + var(--space-5)) calc(var(--section) * 1.5);
		background: linear-gradient(
			to bottom,
			var(--paper) 0,
			color-mix(in srgb, var(--paper), var(--moss-80) 50%) calc(var(--fade-in) * 0.5),
			var(--moss-80) var(--fade-in),
			var(--moss-80) 55%,
			color-mix(in srgb, var(--moss-80), var(--espresso) 50%) 78%,
			var(--espresso) 100%
		);
	}

	/* A soft Espresso pool behind the words keeps them clear of the brightest highlights */
	.statement::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 45% 55% at 50% 50%, rgb(61 47 48 / 0.6), rgb(61 47 48 / 0));
		pointer-events: none;
	}

	@media (max-width: 960px) {
		/* Copy spans the full width on mobile, so the lower half stays shaded */
		.hero-media::after {
			background:
				linear-gradient(to bottom, rgb(61 47 48 / 0.6) 0%, rgb(61 47 48 / 0) 28%),
				linear-gradient(to top, rgb(61 47 48 / 0.7) 0%, rgb(61 47 48 / 0) 55%),
				linear-gradient(to right, rgb(61 47 48 / 0.55) 0%, rgb(61 47 48 / 0) 65%);
		}
	}
</style>
