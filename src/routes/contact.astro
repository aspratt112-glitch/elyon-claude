---
import Layout from '../layouts/Layout.astro';
import { reader, getSettings } from '../lib/content';

const contact = await reader.singletons.contact.readOrThrow();
const settings = await getSettings();
---

<Layout title={contact.seo.title} description={contact.seo.description}>
	<div class="wrap grid grid-cols-2 gap-[clamp(2rem,6vw,6rem)] pb-section max-nav:grid-cols-1 max-nav:gap-0">
		<header class="page-head content-start">
			<p class="label bracket text-ink-muted">{contact.eyebrow}</p>
			<h1 class="text-display">{contact.heading}</h1>
			<p class="lede text-ink-muted">{contact.intro}</p>

			<dl class="mt-6 w-full border-t border-rule">
				{settings.email && (
					<div class="grid grid-cols-[8rem_1fr] border-b border-rule py-4">
						<dt class="label text-ink-muted">Email</dt>
						<dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
					</div>
				)}
				{settings.instagram && (
					<div class="grid grid-cols-[8rem_1fr] border-b border-rule py-4">
						<dt class="label text-ink-muted">Instagram</dt>
						<dd><a href={settings.instagram} rel="noopener">@elyon.labs</a></dd>
					</div>
				)}
				<div class="grid grid-cols-[8rem_1fr] border-b border-rule py-4">
					<dt class="label text-ink-muted">Response</dt>
					<dd>{contact.responseTime}</dd>
				</div>
			</dl>
		</header>

		<form class="grid content-start justify-items-start gap-8 pt-space-6 max-nav:pt-0" id="contact-form" data-email={settings.email}>
			<div class="field w-full">
				<label class="label" for="name">Name</label>
				<input id="name" name="name" required autocomplete="name" />
			</div>
			<div class="field w-full">
				<label class="label" for="email">Email</label>
				<input id="email" name="email" type="email" required autocomplete="email" />
			</div>
			<div class="field w-full">
				<label class="label" for="topic">Topic</label>
				<select id="topic" name="topic">
					{contact.topics.map((topic) => <option>{topic}</option>)}
				</select>
			</div>
			<div class="field w-full">
				<label class="label" for="message">Message</label>
				<textarea id="message" name="message" required></textarea>
			</div>
			<button class="btn" type="submit">Send message</button>
			<p class="mono">Sending opens your email app with your message ready to go.</p>
		</form>
	</div>
</Layout>

<script>
	// No form service is connected yet, so the message is handed to the visitor's email app.
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const subject = encodeURIComponent(`${data.get('topic')}: ${data.get('name')}`);
		const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`);
		window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
	});
</script>

<style>
	/* A small drawn chevron, since the native select arrow is removed */
	select {
		background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
			linear-gradient(135deg, currentColor 50%, transparent 50%);
		background-position: calc(100% - 10px) 50%, calc(100% - 5px) 50%;
		background-size: 5px 5px;
		background-repeat: no-repeat;
	}
</style>
