---
import Layout from '../layouts/Layout.astro';
import { reader, paragraphs, stepNumber } from '../lib/content';

const story = await reader.singletons.story.readOrThrow();
---

<Layout title={story.seo.title} description={story.seo.description}>
	<header class="wrap page-head">
		<p class="label bracket text-ink-muted">{story.eyebrow}</p>
		<h1 class="text-display">{story.heading}</h1>
		<p class="lede text-ink-muted">{story.intro}</p>
	</header>

	{story.image && (
		<div class="wrap">
			<div class="frame aspect-16/7">
				<img src={story.image} alt="" width="2400" height="1050" fetchpriority="high" />
			</div>
		</div>
	)}

	<section class="py-section">
		<div class="wrap grid grid-cols-[4fr_8fr] gap-10 max-desk:grid-cols-1">
			<p class="label bracket sticky top-28 self-start text-ink-muted max-desk:static">Origin</p>
			<div class="prose text-[length:clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.7]">
				{paragraphs(story.body).map((p) => <p class="first:text-[1.3em] first:leading-[1.45]">{p}</p>)}
			</div>
		</div>
	</section>

	<section class="bg-moss on-dark">
		<div class="wrap grid grid-cols-[7fr_5fr] items-center gap-space-6 py-section max-desk:grid-cols-1 max-desk:gap-space-5">
			<div class="stack">
				<p class="label bracket text-ink-muted">Our belief</p>
				<blockquote class="text-display max-w-[12ch]">{story.pullQuote}</blockquote>
			</div>
			{story.secondImage && (
				<div class="frame aspect-4/5">
					<img src={story.secondImage} alt="" loading="lazy" width="875" height="1094" />
				</div>
			)}
		</div>
	</section>

	<section class="py-section">
		<div class="wrap">
			<div class="stack mb-space-5">
				<p class="label bracket text-ink-muted">Who we are</p>
				<h2 class="text-h2 max-w-[22ch]">Masculine, not macho. Premium, not pretentious.</h2>
			</div>
			<ol>
				{story.personality.map((trait, i) => (
					<li
						class="grid grid-cols-[2fr_5fr_5fr] items-baseline gap-6 border-t border-rule py-10 last:border-b
							max-desk:grid-cols-1 max-desk:gap-2"
					>
						<span class="label bracket text-ink-muted">{stepNumber(i + 1)}</span>
						<h3 class="text-h3">{trait.title}</h3>
						<p class="mono max-w-[52ch]">{trait.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>
</Layout>
