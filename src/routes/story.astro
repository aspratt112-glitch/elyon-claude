---
import Layout from '../layouts/Layout.astro';
import { reader, paragraphs, stepNumber } from '../lib/content';

const story = await reader.singletons.story.readOrThrow();
---

<Layout title={story.seo.title} description={story.seo.description}>
	<header class="wrap page-head">
		<p class="label bracket muted">{story.eyebrow}</p>
		<h1 class="display">{story.heading}</h1>
		<p class="lede muted">{story.intro}</p>
	</header>

	{story.image && (
		<div class="wrap">
			<div class="frame ratio-wide">
				<img src={story.image} alt="" width="2400" height="1050" fetchpriority="high" />
			</div>
		</div>
	)}

	<section class="section">
		<div class="wrap body">
			<p class="label bracket muted side">Origin</p>
			<div class="prose">
				{paragraphs(story.body).map((p) => <p>{p}</p>)}
			</div>
		</div>
	</section>

	<section class="quote bg-moss on-dark">
		<div class="wrap quote-inner">
			<div class="stack quote-copy">
				<p class="label bracket muted">Our belief</p>
				<blockquote class="display">{story.pullQuote}</blockquote>
			</div>
			{story.secondImage && (
				<div class="frame ratio-portrait">
					<img src={story.secondImage} alt="" loading="lazy" width="875" height="1094" />
				</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="stack traits-head">
				<p class="label bracket muted">Who we are</p>
				<h2 class="h2">Masculine, not macho. Premium, not pretentious.</h2>
			</div>
			<ol class="traits">
				{story.personality.map((trait, i) => (
					<li>
						<span class="label bracket muted">{stepNumber(i + 1)}</span>
						<h3 class="h3">{trait.title}</h3>
						<p class="mono">{trait.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>
</Layout>

<style>
	.body {
		display: grid;
		grid-template-columns: 4fr 8fr;
		gap: var(--space-4);
	}

	.side {
		position: sticky;
		top: 7rem;
		align-self: start;
	}

	.body .prose {
		font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
		line-height: 1.7;
	}

	.body .prose p:first-child {
		font-size: 1.3em;
		line-height: 1.45;
	}

	.quote-inner {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--space-6);
		align-items: center;
		padding-block: var(--section);
	}

	blockquote {
		margin: 0;
		max-width: 12ch;
	}

	.traits-head {
		margin-bottom: var(--space-5);
	}

	.traits-head h2 {
		max-width: 22ch;
	}

	.traits {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.traits li {
		display: grid;
		grid-template-columns: 2fr 5fr 5fr;
		gap: var(--space-3);
		align-items: baseline;
		padding-block: var(--space-4);
		border-top: 1px solid var(--rule);
	}

	.traits li:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.traits .mono {
		max-width: 52ch;
	}

	@media (max-width: 960px) {
		.body,
		.quote-inner {
			grid-template-columns: 1fr;
		}

		.quote-inner {
			gap: var(--space-5);
		}

		.side {
			position: static;
		}

		.traits li {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
