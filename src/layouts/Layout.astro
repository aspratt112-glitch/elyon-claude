---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string | null;
	description?: string | null;
}

const { title, description } = Astro.props;
const pageTitle = title || "Elyon | Premium Men's Haircare";
const pageDescription =
	description || 'Scientifically formulated haircare for men. Three products. One system. No guesswork.';
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#3d2f30" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip label" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 100;
		padding: 0.75rem 1rem;
		background: var(--espresso);
		color: var(--mineral);
	}

	.skip:focus {
		top: 1rem;
	}
</style>
