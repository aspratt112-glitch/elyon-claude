---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, getProducts } from '../lib/content';

const home = await reader.singletons.home.readOrThrow();
const products = await getProducts();
---

<Layout title={home.seo.title} description={home.seo.description} overlayHeader>
	<section class="hero on-dark" data-header-overlay>
		<div class="hero-media">
			{home.hero.image && <img src={home.hero.image} alt="" width="2400" height="1350" fetchpriority="high" />}
		</div>
		<div class="wrap hero-copy">
			{home.hero.eyebrow && <p class="label bracket">{home.hero.eyebrow}</p>}
			<h1 class="display">{home.hero.heading}</h1>
			<div class="hero-foot">
				<p class="lede muted">{home.hero.text}</p>
				<a class="btn btn--light" href="#system">{home.hero.ctaLabel}</a>
			</div>
		</div>
	</section>

	<section class="section system" id="system">
		<div class="wrap">
			<div class="intro">
				<div class="stack">
					<p class="label bracket muted">{home.system.eyebrow}</p>
					<h2 class="h2">{home.system.heading}</h2>
				</div>
				<p class="lede muted">{home.system.text}</p>
			</div>
			<div class="grid">
				{products.map((product) => <ProductCard product={product} />)}
			</div>
		</div>
	</section>

	<section class="pillars on-dark">
		<div class="wrap">
			<div class="pillar-grid">
				{home.pillars.map((pillar) => (
					<article class="pillar stack">
						<h3 class="h3">{pillar.title}</h3>
						<p class="mono">{pillar.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="statement on-dark">
		{home.statement.image && <img src={home.statement.image} alt="" loading="lazy" />}
		<div class="wrap statement-inner">
			<Monogram class="statement-mark" />
			<p class="h2">{home.statement.text}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap story">
			<div class="frame ratio-landscape">
				{home.story.image && <img src={home.story.image} alt="" loading="lazy" width="1200" height="800" />}
			</div>
			<div class="stack story-copy">
				<p class="label bracket muted">{home.story.eyebrow}</p>
				<h2 class="h2">{home.story.heading}</h2>
				<p class="lede muted">{home.story.text}</p>
				<a class="link-arrow" href="/story">Read our story</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Full-bleed banner that runs up behind the transparent menu */
	.hero {
		position: relative;
		display: grid;
		align-items: end;
		min-height: min(100svh, 1000px);
		margin-top: calc(-1 * var(--header-h) - 1px);
		background: var(--espresso);
		overflow: hidden;
	}

	.hero-media {
		position: absolute;
		inset: 0;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Anchored to the bottom so the ELYON on the bottle sits as high as the crop allows */
		object-position: 70% 100%;
	}

	/* Darkens the top (for the menu) and the left (for the copy); the bottom stays light
	   on the right so the bottle's ELYON lettering isn't shaded out */
	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgb(61 47 48 / 0.6) 0%, rgb(61 47 48 / 0) 28%),
			linear-gradient(to top, rgb(61 47 48 / 0.3) 0%, rgb(61 47 48 / 0) 35%),
			linear-gradient(to right, rgb(61 47 48 / 0.7) 0%, rgb(61 47 48 / 0.35) 40%, rgb(61 47 48 / 0) 60%);
	}

	.hero-copy {
		position: relative;
		display: grid;
		gap: var(--space-3);
		justify-items: start;
		padding-top: calc(var(--header-h) + var(--space-6));
		padding-bottom: var(--space-5);
	}

	.hero-copy h1 {
		max-width: 20ch;
	}

	.hero-foot {
		display: grid;
		gap: var(--space-4);
		justify-items: start;
		width: min(100%, 34rem);
		margin-top: var(--space-3);
		padding-top: var(--space-4);
		border-top: 1px solid var(--rule);
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4) var(--space-5);
		align-items: end;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-5);
	}

	/* The section above hands its bottom spacing to the pillars' fade-in */
	.system {
		padding-bottom: var(--space-5);
	}

	/* Moss at 80% (#63655a): fades in from Mineral White, then eases into Espresso so it
	   runs straight into the statement band. The fades sit in the padding, so text only
	   ever sits on solid Moss. Only full Mineral White passes AA on this tint (5.3:1). */
	.pillars {
		--moss-80: #63655a;
		--fade-in: calc(var(--section) * 1.1);
		--ink-muted: var(--mineral);
		padding-block: calc(var(--fade-in) + var(--space-5)) calc(var(--section) * 1.5);
		background: linear-gradient(
			to bottom,
			var(--paper) 0,
			color-mix(in srgb, var(--paper), var(--moss-80) 50%) calc(var(--fade-in) * 0.5),
			var(--moss-80) var(--fade-in),
			var(--moss-80) 55%,
			color-mix(in srgb, var(--moss-80), var(--espresso) 50%) 78%,
			var(--espresso) 100%
		);
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-block: 1px solid var(--rule);
	}

	.pillar {
		padding: var(--space-5) var(--space-4);
		border-left: 1px solid var(--rule);
	}

	.pillar:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.pillar:last-child {
		padding-right: 0;
	}

	.pillar .mono {
		max-width: 38ch;
	}

	.statement {
		position: relative;
		display: grid;
		min-height: min(72vh, 760px);
		/* Overlap by 1px so sub-pixel rounding can't open a seam with the gradient above */
		margin-top: -1px;
		background: var(--espresso);
		overflow: hidden;
	}

	/* The source image is low resolution, so it's softened into texture */
	.statement img {
		position: absolute;
		inset: -12px;
		width: calc(100% + 24px);
		height: calc(100% + 24px);
		object-fit: cover;
		opacity: 0.22;
		filter: blur(3px) saturate(0.6);
		/* Fade the texture in from plain Espresso so there's no seam with the section above */
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
	}

	.statement-inner {
		position: relative;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: var(--space-4);
		padding-block: var(--space-6);
		text-align: center;
	}

	.statement-inner p {
		max-width: 18ch;
	}

	:global(.statement-mark) {
		width: 2.5rem;
		height: auto;
	}

	.story {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--space-6);
		align-items: center;
	}

	.story-copy {
		gap: var(--space-3);
	}

	.story-copy .link-arrow {
		margin-top: var(--space-2);
	}

	@media (max-width: 960px) {
		.story,
		.intro {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: min(100svh, 760px);
		}

		.hero-media img {
			object-position: 72% 50%;
		}

		/* Copy spans the full width on mobile, so the lower half stays shaded */
		.hero-media::after {
			background:
				linear-gradient(to bottom, rgb(61 47 48 / 0.6) 0%, rgb(61 47 48 / 0) 28%),
				linear-gradient(to top, rgb(61 47 48 / 0.7) 0%, rgb(61 47 48 / 0) 55%),
				linear-gradient(to right, rgb(61 47 48 / 0.55) 0%, rgb(61 47 48 / 0) 65%);
		}

		.grid,
		.pillar-grid {
			grid-template-columns: 1fr;
		}

		.grid {
			gap: var(--space-5);
		}

		.pillar,
		.pillar:first-child,
		.pillar:last-child {
			border-left: 0;
			border-top: 1px solid var(--rule);
			padding: var(--space-4) 0;
		}

		.pillar:first-child {
			border-top: 0;
		}

		.story {
			gap: var(--space-4);
		}
	}
</style>
