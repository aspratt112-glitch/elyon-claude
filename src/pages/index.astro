---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, getProducts, stepNumber } from '../lib/content';

const home = await reader.singletons.home.readOrThrow();
const products = await getProducts();
---

<Layout title={home.seo.title} description={home.seo.description}>
	<section class="hero">
		<div class="hero-copy bg-moss on-dark">
			<p class="label bracket">{home.hero.eyebrow}</p>
			<h1 class="display">{home.hero.heading}</h1>
			<div class="hero-foot">
				<p class="lede muted">{home.hero.text}</p>
				<a class="btn btn--light" href="#system">{home.hero.ctaLabel}</a>
			</div>
		</div>
		<div class="hero-media frame">
			{home.hero.image && <img src={home.hero.image} alt="" width="1200" height="1500" fetchpriority="high" />}
		</div>
	</section>

	<section class="section" id="system">
		<div class="wrap">
			<div class="intro">
				<div class="stack">
					<p class="label bracket muted">{home.system.eyebrow}</p>
					<h2 class="h2">{home.system.heading}</h2>
				</div>
				<p class="lede muted">{home.system.text}</p>
			</div>
			<div class="steps label">
				{products.map((p) => (
					<span>
						<span class="bracket">{stepNumber(p.step)}</span>
						<span class="muted">{p.stepLabel}</span>
					</span>
				))}
			</div>
			<div class="grid">
				{products.map((product) => <ProductCard product={product} />)}
			</div>
		</div>
	</section>

	<section class="pillars on-dark">
		<div class="wrap">
			<div class="pillar-grid">
				{home.pillars.map((pillar) => (
					<article class="pillar stack">
						<h3 class="h3">{pillar.title}</h3>
						<p class="mono">{pillar.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="statement on-dark">
		{home.statement.image && <img src={home.statement.image} alt="" loading="lazy" />}
		<div class="wrap statement-inner">
			<Monogram class="statement-mark" />
			<p class="h2">{home.statement.text}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap story">
			<div class="frame ratio-landscape">
				{home.story.image && <img src={home.story.image} alt="" loading="lazy" width="1200" height="800" />}
			</div>
			<div class="stack story-copy">
				<p class="label bracket muted">{home.story.eyebrow}</p>
				<h2 class="h2">{home.story.heading}</h2>
				<p class="lede muted">{home.story.text}</p>
				<a class="link-arrow" href="/story">Read our story</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: min(90vh, 920px);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-5);
		padding: var(--space-6) var(--gutter) var(--space-5);
	}

	.hero-copy h1 {
		max-width: 15ch;
		margin-top: auto;
	}

	.hero-foot {
		display: grid;
		gap: var(--space-4);
		justify-items: start;
		padding-top: var(--space-4);
		border-top: 1px solid var(--rule);
	}

	.hero-media img {
		position: absolute;
		inset: 0;
		object-position: 75% 50%;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4) var(--space-5);
		align-items: end;
	}

	.steps {
		display: flex;
		gap: var(--space-5);
		margin-block: var(--space-5) var(--space-4);
		padding-block: var(--space-2);
		border-block: 1px solid var(--rule);
	}

	.steps > span {
		display: inline-flex;
		gap: var(--space-2);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
	}

	/* Moss at 80% (#63655a), easing into Espresso so it runs straight into the statement band.
	   Only full Mineral White passes AA on this tint (5.3:1), so muted text is lifted here. */
	.pillars {
		--moss-80: #63655a;
		--ink-muted: var(--mineral);
		padding-block: var(--section) calc(var(--section) * 1.5);
		background: linear-gradient(
			to bottom,
			var(--moss-80) 0%,
			var(--moss-80) 45%,
			color-mix(in srgb, var(--moss-80), var(--espresso) 50%) 75%,
			var(--espresso) 100%
		);
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-block: 1px solid var(--rule);
	}

	.pillar {
		padding: var(--space-5) var(--space-4);
		border-left: 1px solid var(--rule);
	}

	.pillar:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.pillar:last-child {
		padding-right: 0;
	}

	.pillar .mono {
		max-width: 38ch;
	}

	.statement {
		position: relative;
		display: grid;
		min-height: min(72vh, 760px);
		/* Overlap by 1px so sub-pixel rounding can't open a seam with the gradient above */
		margin-top: -1px;
		background: var(--espresso);
		overflow: hidden;
	}

	/* The source image is low resolution, so it's softened into texture */
	.statement img {
		position: absolute;
		inset: -12px;
		width: calc(100% + 24px);
		height: calc(100% + 24px);
		object-fit: cover;
		opacity: 0.22;
		filter: blur(3px) saturate(0.6);
		/* Fade the texture in from plain Espresso so there's no seam with the section above */
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
	}

	.statement-inner {
		position: relative;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: var(--space-4);
		padding-block: var(--space-6);
		text-align: center;
	}

	.statement-inner p {
		max-width: 18ch;
	}

	:global(.statement-mark) {
		width: 2.5rem;
		height: auto;
	}

	.story {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--space-6);
		align-items: center;
	}

	.story-copy {
		gap: var(--space-3);
	}

	.story-copy .link-arrow {
		margin-top: var(--space-2);
	}

	@media (max-width: 960px) {
		.hero,
		.story,
		.intro {
			grid-template-columns: 1fr;
		}

		.hero-media {
			min-height: 75vw;
			order: -1;
		}

		.hero-copy h1 {
			margin-top: 0;
		}

		.grid,
		.pillar-grid {
			grid-template-columns: 1fr;
		}

		.grid {
			gap: var(--space-5);
		}

		.pillar,
		.pillar:first-child,
		.pillar:last-child {
			border-left: 0;
			border-top: 1px solid var(--rule);
			padding: var(--space-4) 0;
		}

		.pillar:first-child {
			border-top: 0;
		}

		.steps {
			justify-content: space-between;
			gap: var(--space-2);
		}

		.story {
			gap: var(--space-4);
		}
	}
</style>
