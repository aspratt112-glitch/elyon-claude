---
import Layout from '../layouts/Layout.astro';
import Monogram from '../components/logos/Monogram.astro';
import { reader, stepNumber } from '../lib/content';

const mission = await reader.singletons.mission.readOrThrow();
---

<Layout title={mission.seo.title} description={mission.seo.description}>
	<section class="hero bg-espresso on-dark">
		<div class="wrap hero-inner">
			<p class="label bracket">{mission.eyebrow}</p>
			<h1 class="display">{mission.heading}</h1>
			<p class="statement">{mission.mission}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap vision">
			{mission.image && <img src={mission.image} alt="" loading="lazy" width="1203" height="1523" />}
			<div class="vision-copy">
				<p class="label bracket">Vision</p>
				<p class="vision-text">{mission.vision}</p>
			</div>
		</div>
	</section>

	<section class="section values-section rule-top">
		<div class="wrap">
			<div class="values-head">
				<p class="label bracket">Values</p>
				<h2 class="h2">{mission.valuesHeading}</h2>
			</div>
			<ol class="values">
				{mission.values.map((value, i) => (
					<li>
						<span class="label bracket">{stepNumber(i + 1)}</span>
						<h3 class="h3">{value.title}</h3>
						<p class="mono">{value.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="promise bg-olive on-dark">
		<div class="wrap promise-inner">
			<Monogram class="mark" />
			<p class="h2">{mission.promise}</p>
		</div>
	</section>
</Layout>

<style>
	.hero-inner {
		display: grid;
		gap: 2rem;
		padding-block: clamp(4rem, 10vw, 9rem);
	}

	.statement {
		max-width: 34ch;
		margin-top: 1rem;
		font-size: clamp(1.25rem, 2.4vw, 2rem);
		line-height: 1.3;
	}

	.vision {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
	}

	.vision img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.vision-copy {
		display: grid;
		gap: 2rem;
	}

	.vision-text {
		font-size: clamp(1.25rem, 2.2vw, 1.85rem);
		line-height: 1.35;
		max-width: 30ch;
	}

	.values-head {
		display: grid;
		gap: 1.5rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.values {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.values li {
		display: grid;
		grid-template-columns: 6rem 1fr 1.3fr;
		gap: 1.5rem;
		align-items: baseline;
		padding-block: clamp(1.5rem, 3vw, 2.25rem);
		border-top: 1px solid var(--rule);
	}

	.values li:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.values .h3 {
		font-size: clamp(1.4rem, 2.6vw, 2.25rem);
	}

	.values .mono {
		max-width: 48ch;
	}

	.promise-inner {
		display: grid;
		justify-items: center;
		gap: 2rem;
		padding-block: var(--section);
		text-align: center;
	}

	.promise-inner p {
		max-width: 24ch;
	}

	:global(.mark) {
		width: 3rem;
		height: auto;
	}

	@media (max-width: 860px) {
		.vision {
			grid-template-columns: 1fr;
		}

		.values li {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
