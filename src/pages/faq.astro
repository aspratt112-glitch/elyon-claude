---
import Layout from '../layouts/Layout.astro';
import { reader, paragraphs } from '../lib/content';

const faq = await reader.singletons.faq.readOrThrow();
---

<Layout title={faq.seo.title} description={faq.seo.description}>
	<div class="wrap layout">
		<header class="page-head head">
			<p class="label bracket">{faq.eyebrow}</p>
			<h1 class="display">{faq.heading}</h1>
			<p class="lede">{faq.intro}</p>
			<a class="link-arrow" href="/contact">Ask us directly</a>
		</header>

		<div class="groups">
			{faq.groups.map((group) => (
				<section class="group">
					<h2 class="label bracket">{group.title}</h2>
					{group.items.map((item) => (
						<details>
							<summary>
								<span class="q">{item.question}</span>
								<span class="icon" aria-hidden="true"></span>
							</summary>
							<div class="prose answer">
								{paragraphs(item.answer).map((p) => <p>{p}</p>)}
							</div>
						</details>
					))}
				</section>
			))}
		</div>
	</div>
</Layout>

<style>
	.layout {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: clamp(2rem, 6vw, 6rem);
		padding-bottom: var(--section);
	}

	.head {
		position: sticky;
		top: 5rem;
		align-self: start;
		justify-items: start;
	}

	.head h1 {
		font-size: clamp(2.6rem, 5.5vw, 5rem);
	}

	.groups {
		display: grid;
		gap: 4rem;
		padding-top: clamp(3.5rem, 9vw, 8rem);
	}

	.group h2 {
		margin-bottom: 1rem;
		opacity: 0.6;
	}

	details {
		border-top: 1px solid var(--rule);
	}

	.group details:last-child {
		border-bottom: 1px solid var(--rule);
	}

	summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		padding-block: 1.5rem;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.q {
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
	}

	.icon {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
	}

	.icon::before,
	.icon::after {
		content: '';
		position: absolute;
		inset: 6px 0 auto 0;
		height: 1.5px;
		background: currentColor;
		transition: transform 0.2s;
	}

	.icon::after {
		transform: rotate(90deg);
	}

	details[open] .icon::after {
		transform: rotate(0deg);
	}

	.answer {
		padding-bottom: 1.75rem;
		font-family: var(--font-mono);
		font-weight: 300;
		font-size: 0.875rem;
		line-height: 1.75;
	}

	@media (max-width: 960px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.head {
			position: static;
		}

		.groups {
			padding-top: 0;
		}
	}
</style>
