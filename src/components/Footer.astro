---
import Wordmark from './logos/Wordmark.astro';
import Monogram from './logos/Monogram.astro';
import { getSettings, getProducts } from '../lib/content';

const settings = await getSettings();
const products = await getProducts();
const year = new Date().getFullYear();
---

<footer class="bg-espresso on-dark pt-[clamp(4rem,8vw,6rem)]">
	<div class="wrap grid grid-cols-[repeat(3,minmax(0,1fr))_minmax(0,1.6fr)] gap-10 max-nav:grid-cols-2">
		<div>
			<p class="label mb-5 text-ink-muted">Explore</p>
			<ul class="grid gap-[0.55rem] text-[0.9375rem]">
				<li><a class="hover:underline hover:underline-offset-4" href="/#system">Shop</a></li>
				<li><a class="hover:underline hover:underline-offset-4" href="/story">Our Story</a></li>
				<li><a class="hover:underline hover:underline-offset-4" href="/mission">Mission</a></li>
				<li><a class="hover:underline hover:underline-offset-4" href="/faq">FAQs</a></li>
				<li><a class="hover:underline hover:underline-offset-4" href="/contact">Contact</a></li>
			</ul>
		</div>

		<div>
			<p class="label mb-5 text-ink-muted">The System</p>
			<ul class="grid gap-[0.55rem] text-[0.9375rem]">
				{products.map((p) => <li><a class="hover:underline hover:underline-offset-4" href={`/products/${p.slug}`}>{p.name}</a></li>)}
			</ul>
		</div>

		<div>
			<p class="label mb-5 text-ink-muted">Connect</p>
			<ul class="grid gap-[0.55rem] text-[0.9375rem]">
				{settings.instagram && <li><a class="hover:underline hover:underline-offset-4" href={settings.instagram} rel="noopener">Instagram</a></li>}
				{settings.facebook && <li><a class="hover:underline hover:underline-offset-4" href={settings.facebook} rel="noopener">Facebook</a></li>}
				{settings.email && <li><a class="hover:underline hover:underline-offset-4" href={`mailto:${settings.email}`}>{settings.email}</a></li>}
			</ul>
		</div>

		<form
			class="max-nav:col-span-full"
			id="newsletter"
			data-klaviyo-key={settings.klaviyo.publicKey}
			data-klaviyo-list={settings.klaviyo.listId}
			data-source="Footer"
		>
			<p class="label mb-5 text-ink-muted">{settings.newsletterHeading}</p>
			<p class="mono mb-6 max-w-[42ch]">{settings.newsletterText}</p>
			<div class="signup flex border-b border-mineral">
				<label class="sr-only" for="newsletter-email">Email address</label>
				<input
					class="min-w-0 flex-1 py-[0.9rem] placeholder:text-[rgb(243_241_243/0.55)] focus:outline-none"
					id="newsletter-email"
					name="email"
					type="email"
					placeholder="Email address"
					required
					autocomplete="email"
				/>
				<button class="label cursor-pointer pl-4" type="submit">Join</button>
			</div>
			<p class="status label mt-4" role="status" hidden></p>
		</form>
	</div>

	<div class="wrap pt-[clamp(4rem,10vw,8rem)] pb-6">
		<Wordmark class="h-auto w-full" />
		<div class="label mt-8 flex items-center gap-6 border-t border-rule pt-5 text-[0.625rem] max-nav:flex-wrap">
			<Monogram class="h-auto w-7" />
			<span>{settings.footerTagline}</span>
			<span class="ml-auto">© {year} Elyon Labs</span>
		</div>
	</div>
</footer>

<script>
	import { handleSignup } from '../lib/subscribe';

	const form = document.querySelector<HTMLFormElement>('#newsletter');
	const status = form?.querySelector<HTMLElement>('.status');

	if (form && status) {
		handleSignup(form, {
			onSuccess: () => {
				form.querySelector<HTMLElement>('.signup')!.hidden = true;
				status.textContent = "Thank you. You're on the list.";
				status.hidden = false;
			},
			onError: () => {
				status.textContent = 'Something went wrong. Please try again.';
				status.hidden = false;
			},
		});
	}
</script>

