---
import { stepNumber, type Product } from '../lib/content';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a class="card" href={`/products/${product.slug}`}>
	<div class="media">
		{product.image && <img src={product.image} alt={product.name} loading="lazy" width="800" height="1000" />}
		<span class="tag label bracket">{stepNumber(product.step)}</span>
	</div>
	<div class="body">
		<p class="label meta">
			<span>{product.stepLabel}</span>
			{product.status === 'coming-soon' && <span>Coming soon</span>}
		</p>
		<h3 class="h3">{product.name}</h3>
		<p class="label notes bracket">{product.keyNotes}</p>
		<p class="mono summary">{product.summary}</p>
		<span class="link-arrow">View product</span>
	</div>
</a>

<style>
	.card {
		display: grid;
		gap: 1.5rem;
		text-decoration: none;
	}

	.media {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--olive-30);
	}

	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.card:hover .media img {
		transform: scale(1.03);
	}

	.tag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		padding: 0.4rem 0.6rem;
		background: var(--paper);
		color: var(--espresso);
	}

	.body {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		width: 100%;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}

	.meta span:last-child {
		opacity: 0.6;
	}

	.notes {
		opacity: 0.75;
	}

	.summary {
		max-width: 38ch;
		margin-bottom: 0.5rem;
	}
</style>
