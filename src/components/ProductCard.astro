---
import { stepNumber, type Product } from '../lib/content';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a class="card" href={`/products/${product.slug}`}>
	<div class="frame ratio-portrait media">
		{product.image && <img src={product.image} alt={product.name} loading="lazy" width="800" height="1000" />}
		<span class="tag label bracket">{stepNumber(product.step)}</span>
	</div>
	<div class="body">
		<p class="label meta">
			<span>{product.stepLabel}</span>
			{product.status === 'coming-soon' && <span class="muted">Coming soon</span>}
		</p>
		<h3 class="h3">{product.name}</h3>
		<p class="label bracket muted">{product.keyNotes}</p>
		<p class="mono summary">{product.summary}</p>
		<span class="link-arrow">View product</span>
	</div>
</a>

<style>
	.card {
		display: grid;
		gap: var(--space-3);
		align-content: start;
		text-decoration: none;
	}

	.media img {
		transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
	}

	.card:hover .media img {
		transform: scale(1.025);
	}

	.tag {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		padding: 0.45rem 0.6rem;
		background: var(--mineral);
		color: var(--espresso);
	}

	.body {
		display: grid;
		gap: var(--space-2);
		justify-items: start;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		width: 100%;
		padding-bottom: var(--space-2);
		margin-bottom: var(--space-1);
		border-bottom: 1px solid var(--rule);
	}

	.summary {
		max-width: 40ch;
		margin-bottom: var(--space-1);
	}
</style>
