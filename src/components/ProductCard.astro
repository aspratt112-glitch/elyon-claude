---
import { stepNumber, type Product } from '../lib/content';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a class="group grid content-start gap-6" href={`/products/${product.slug}`}>
	<div class="frame aspect-4/5">
		{product.image && (
			<img
				class="transition-transform duration-900 ease-[cubic-bezier(0.2,0.6,0.2,1)] group-hover:scale-[1.025]"
				src={product.image}
				alt={product.name}
				loading="lazy"
				width="800"
				height="1000"
			/>
		)}
		<span class="label bracket absolute top-4 left-4 bg-mineral px-[0.6rem] py-[0.45rem] text-espresso">{stepNumber(product.step)}</span>
	</div>
	<div class="grid justify-items-start gap-4">
		<p class="label mb-2 flex w-full justify-between border-b border-rule pb-4">
			<span>{product.stepLabel}</span>
			{product.status === 'coming-soon' && <span class="text-ink-muted">Coming soon</span>}
		</p>
		<h3 class="text-h3">{product.name}</h3>
		<p class="label bracket text-ink-muted">{product.keyNotes}</p>
		<p class="mono mb-2 max-w-[40ch]">{product.summary}</p>
		<span class="link-arrow">View product</span>
	</div>
</a>
