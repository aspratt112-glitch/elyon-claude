---
import Monogram from './logos/Monogram.astro';
import { getSettings } from '../lib/content';

interface Props {
	eyebrow?: string | null;
	heading?: string | null;
	text?: string | null;
	buttonLabel?: string | null;
	image?: string | null;
}

const { eyebrow, heading, text, buttonLabel, image } = Astro.props;
const settings = await getSettings();
---

<dialog
	class="signup-popup bg-espresso on-dark max-h-[calc(100dvh-2rem)] w-[min(100%-2rem,44rem)] overflow-auto border border-rule
		text-mineral open:animate-popup-in motion-reduce:open:animate-none backdrop:bg-[rgb(61_47_48/0.6)] backdrop:backdrop-blur-[2px]"
	aria-labelledby="signup-popup-heading"
>
	<div class:list={[image && 'grid grid-cols-[2fr_3fr] max-[721px]:relative max-[721px]:grid-cols-1']}>
		{image && (
			// On phones the photo sits behind the form at half strength
			<div class="relative bg-moss max-[721px]:absolute max-[721px]:inset-0 max-[721px]:opacity-50">
				<img class="absolute inset-0 size-full object-cover object-[30%_50%] max-[721px]:object-[40%_50%]" src={image} alt="" loading="lazy" />
			</div>
		)}

		{/* Over the photo on phones, the softer grey text loses contrast, so it all goes full Mineral White */}
		<form
			class="relative grid gap-6 px-[clamp(1.25rem,3vw,2.25rem)] pt-10 pb-6
				max-[721px]:[--ink-muted:var(--mineral)] max-[721px]:[text-shadow:0_1px_12px_rgb(61_47_48/0.6)]"
			data-klaviyo-key={settings.klaviyo.publicKey}
			data-klaviyo-list={settings.klaviyo.listId}
			data-source="Home page popup"
		>
			<button class="label absolute top-4 right-6 cursor-pointer py-2" type="button" data-close aria-label="Close">Close ✕</button>

			<div class="stack gap-4">
				<Monogram class="h-auto w-[1.4rem]" />
				{eyebrow && <p class="label bracket text-ink-muted">{eyebrow}</p>}
				<h2 class="text-[length:clamp(1.35rem,2vw,1.75rem)]" id="signup-popup-heading">{heading}</h2>
				{text && <p class="mono max-w-[42ch] text-[0.75rem]">{text}</p>}
			</div>

			<div class="grid grid-cols-2 gap-x-6 gap-y-4 max-[721px]:grid-cols-1" data-signup-step>
				<div class="field">
					<label class="label text-ink-muted" for="popup-first-name">First name</label>
					<input class="py-[0.55rem] text-[0.9375rem]" id="popup-first-name" name="firstName" type="text" required autocomplete="given-name" />
				</div>
				<div class="field">
					<label class="label text-ink-muted" for="popup-last-name">Last name</label>
					<input class="py-[0.55rem] text-[0.9375rem]" id="popup-last-name" name="lastName" type="text" required autocomplete="family-name" />
				</div>
				<div class="field col-span-full">
					<label class="label text-ink-muted" for="popup-email">Email</label>
					<input class="py-[0.55rem] text-[0.9375rem]" id="popup-email" name="email" type="email" required autocomplete="email" />
				</div>
			</div>

			<button class="btn btn--light min-h-12 w-full" type="submit" data-signup-step>{buttonLabel || 'Join'}</button>
			<p class="error label text-center" role="alert" hidden>
				Something went wrong. Please try again{settings.email && `, or email us at ${settings.email}`}.
			</p>
			<button
				class="label -mt-2 cursor-pointer justify-self-center border-b border-rule-strong py-2 text-ink-muted hover:text-mineral"
				type="button"
				data-close
				data-signup-step
			>
				No thanks
			</button>
			<p class="thanks text-h3 border-t border-rule pt-4 pb-6" role="status" hidden>Thank you. You're on the list.</p>
		</form>
	</div>
</dialog>

<script>
	import { handleSignup } from '../lib/subscribe';

	// Opens shortly after every load of the home page.
	const dialog = document.querySelector<HTMLDialogElement>('.signup-popup');
	const form = dialog?.querySelector('form');

	if (dialog && form) {
		setTimeout(() => dialog.showModal(), 1200);

		const close = () => dialog.close();

		dialog.querySelectorAll('[data-close]').forEach((button) => button.addEventListener('click', close));
		// Clicking the dimmed backdrop (the dialog element itself) closes it
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) close();
		});

		const error = form.querySelector<HTMLElement>('.error');
		const thanks = form.querySelector<HTMLElement>('.thanks');

		handleSignup(form, {
			// Swap the form for a thank-you, then close on its own
			onSuccess: () => {
				form.querySelectorAll<HTMLElement>('[data-signup-step], .error').forEach((el) => (el.hidden = true));
				if (thanks) thanks.hidden = false;
				setTimeout(close, 2500);
			},
			onError: () => {
				if (error) error.hidden = false;
			},
		});
	}
</script>

