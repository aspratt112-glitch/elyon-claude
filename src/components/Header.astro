---
import Wordmark from './logos/Wordmark.astro';
import Monogram from './logos/Monogram.astro';
import { getSettings, getProducts } from '../lib/content';

interface Props {
	/** Sit transparently over the page's first element (marked data-header-overlay) until it scrolls away. */
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const settings = await getSettings();
const [mainMessage, ...otherMessages] = settings.announcements;
const products = await getProducts();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const left = [
	{ href: '/#system', label: 'Shop' },
	{ href: '/story', label: 'Our Story' },
	{ href: '/mission', label: 'Mission' },
];
const right = [
	{ href: '/faq', label: 'FAQ' },
	{ href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => href === path;
---

<div class="announce bg-espresso on-dark">
	<ul class="wrap label">
		{mainMessage && <li class="announce-main">{mainMessage}</li>}
		{otherMessages.length > 0 && (
			<li class="announce-rest">
				{otherMessages.map((message) => <span>{message}</span>)}
			</li>
		)}
	</ul>
</div>

<header class="site-header" data-overlay={overlay ? '' : undefined}>
	<div class="wrap bar">
		<nav class="nav nav--left" aria-label="Primary">
			<a href="/" class="mono-link" aria-label="Elyon home">
				<Monogram class="monogram" />
			</a>
			{left.map((item) => (
				<a class="label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<a href="/" class="brand" aria-label="Elyon home">
			<Wordmark class="wordmark" />
		</a>

		<nav class="nav nav--right" aria-label="Secondary">
			{right.map((item) => (
				<a class="label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<details class="menu">
			<summary class="label">
				<span class="menu-open">Menu</span>
				<span class="menu-close">Close</span>
			</summary>
			<div class="menu-panel bg-espresso on-dark">
				<ul>
					{[...left, ...right].map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
				<ul class="menu-products label">
					{products.map((p) => (
						<li><a href={`/products/${p.slug}`}>{p.name}</a></li>
					))}
				</ul>
			</div>
		</details>
	</div>
</header>

<script>
	// Close the mobile menu after following an in-page link.
	document.querySelectorAll<HTMLAnchorElement>('.menu-panel a').forEach((link) => {
		link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
	});

	// Overlay mode: stay transparent while the banner is behind the menu, then turn solid.
	const header = document.querySelector<HTMLElement>('.site-header[data-overlay]');
	const banner = document.querySelector<HTMLElement>('[data-header-overlay]');
	if (header && banner) {
		const observer = new IntersectionObserver(
			([entry]) => header.toggleAttribute('data-solid', !entry.isIntersecting),
			{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
		);
		observer.observe(banner);
	}
</script>

<style>
	/* First message sits in the true centre; any others line up on the right */
	.announce ul {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		margin: 0 auto;
		padding-block: 0.6rem;
		list-style: none;
		font-size: 0.625rem;
	}

	.announce-main {
		grid-column: 2;
		text-align: center;
	}

	.announce-rest {
		grid-column: 3;
		justify-self: end;
		display: flex;
		gap: 2rem;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
		transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
	}

	/* Transparent over the banner. Only applied when JavaScript can turn it solid again. */
	:global(html.js) .site-header[data-overlay]:not([data-solid]) {
		background: transparent;
		border-bottom-color: rgb(243 241 243 / 0.2);
		color: var(--mineral);
	}

	.bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: var(--header-h);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2.25rem);
	}

	.nav--right {
		justify-content: flex-end;
	}

	.nav a {
		text-decoration: none;
		padding-block: 0.4rem;
		border-bottom: 1px solid transparent;
	}

	.nav a.label:hover,
	.nav a[aria-current='page'] {
		border-bottom-color: currentColor;
	}

	:global(.monogram) {
		width: 1.6rem;
		height: auto;
	}

	:global(.wordmark) {
		width: clamp(7rem, 11vw, 9.5rem);
		height: auto;
	}

	.menu {
		display: none;
	}

	@media (max-width: 860px) {
		.announce-rest {
			display: none;
		}

		.bar {
			grid-template-columns: auto 1fr auto;
		}

		.nav a.label,
		.nav--right {
			display: none;
		}

		.brand {
			justify-self: center;
		}

		.menu {
			display: block;
			justify-self: end;
		}

		.menu summary {
			list-style: none;
			cursor: pointer;
			padding: 0.75rem 0;
		}

		.menu summary::-webkit-details-marker {
			display: none;
		}

		.menu-close,
		.menu[open] .menu-open {
			display: none;
		}

		.menu[open] .menu-close {
			display: inline;
		}

		.menu-panel {
			position: fixed;
			inset: 4.5rem 0 0 0;
			padding: 2.5rem var(--gutter);
			display: grid;
			align-content: start;
			gap: 3rem;
			overflow-y: auto;
		}

		.menu-panel ul {
			margin: 0;
			padding: 0;
			list-style: none;
			display: grid;
			gap: 1.1rem;
		}

		.menu-panel ul:first-child a {
			font-size: 2rem;
			text-transform: uppercase;
			letter-spacing: 0;
			text-decoration: none;
		}

		.menu-products {
			border-top: 1px solid var(--rule);
			padding-top: 2rem !important;
		}

		.menu-products a {
			text-decoration: none;
		}
	}
</style>
