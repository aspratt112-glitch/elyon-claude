---
import Wordmark from './logos/Wordmark.astro';
import Monogram from './logos/Monogram.astro';
import { getSettings, getProducts } from '../lib/content';

interface Props {
	/** Sit transparently over the page's first element (marked data-header-overlay) until it scrolls away. */
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const settings = await getSettings();
const [mainMessage, ...otherMessages] = settings.announcements;
const products = await getProducts();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const left = [
	{ href: '/#system', label: 'Shop' },
	{ href: '/story', label: 'Our Story' },
	{ href: '/mission', label: 'Mission' },
];
const right = [
	{ href: '/faq', label: 'FAQ' },
	{ href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => href === path;
---

{/* First message sits in the true centre; any others line up on the right */}
<div class="bg-espresso on-dark">
	<ul class="wrap label grid grid-cols-[1fr_auto_1fr] items-center gap-8 py-[0.6rem] text-[0.625rem]">
		{mainMessage && <li class="col-start-2 text-center">{mainMessage}</li>}
		{otherMessages.length > 0 && (
			<li class="col-start-3 flex gap-8 justify-self-end max-nav:hidden">
				{otherMessages.map((message) => <span>{message}</span>)}
			</li>
		)}
	</ul>
</div>

<header
	class="site-header sticky top-0 z-50 border-b border-rule bg-paper transition-[background-color,color,border-color] duration-400 ease-[ease]"
	data-overlay={overlay ? '' : undefined}
>
	<div class="wrap grid min-h-header grid-cols-[1fr_auto_1fr] items-center max-nav:grid-cols-[auto_1fr_auto]">
		<nav class="flex items-center gap-[clamp(1rem,2.5vw,2.25rem)]" aria-label="Primary">
			<a href="/" class="border-b border-transparent py-[0.4rem]" aria-label="Elyon home">
				<Monogram class="h-auto w-[1.6rem]" />
			</a>
			{left.map((item) => (
				<a class="label border-b border-transparent py-[0.4rem] hover:border-current aria-[current=page]:border-current max-nav:hidden" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<a href="/" class="max-nav:justify-self-center" aria-label="Elyon home">
			<Wordmark class="h-auto w-[clamp(7rem,11vw,9.5rem)]" />
		</a>

		<nav class="flex items-center justify-end gap-[clamp(1rem,2.5vw,2.25rem)] max-nav:hidden" aria-label="Secondary">
			{right.map((item) => (
				<a class="label border-b border-transparent py-[0.4rem] hover:border-current aria-[current=page]:border-current max-nav:hidden" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<details class="menu group hidden max-nav:block max-nav:justify-self-end">
			<summary class="label cursor-pointer list-none py-3 [&::-webkit-details-marker]:hidden">
				<span class="group-open:hidden">Menu</span>
				<span class="hidden group-open:inline">Close</span>
			</summary>
			{/* Hangs directly under the header (its positioned ancestor), wherever the header
			    sits, so it never rides up over the logo row when the announcement bar is showing */}
			<div
				class="menu-panel bg-espresso on-dark absolute inset-x-0 top-full grid h-[calc(100dvh-var(--header-h))] content-start
					gap-space-5 overflow-y-auto border-t border-rule px-gutter py-10"
			>
				<ul class="grid gap-[1.1rem]">
					{[...left, ...right].map((item) => (
						<li><a class="text-[2rem] tracking-normal uppercase" href={item.href}>{item.label}</a></li>
					))}
				</ul>
				<ul class="label grid gap-[1.1rem] border-t border-rule pt-8">
					{products.map((p) => (
						<li><a href={`/products/${p.slug}`}>{p.name}</a></li>
					))}
				</ul>
			</div>
		</details>
	</div>
</header>

<script>
	// Close the mobile menu after following an in-page link.
	document.querySelectorAll<HTMLAnchorElement>('.menu-panel a').forEach((link) => {
		link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
	});

	// Overlay mode: stay transparent while the banner is behind the menu, then turn solid.
	const header = document.querySelector<HTMLElement>('.site-header[data-overlay]');
	const banner = document.querySelector<HTMLElement>('[data-header-overlay]');
	if (header && banner) {
		const observer = new IntersectionObserver(
			([entry]) => header.toggleAttribute('data-solid', !entry.isIntersecting),
			{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
		);
		observer.observe(banner);
	}
</script>

<style>
	/* Overlay mode: transparent over the home banner. Only applied when JavaScript can turn
	   it solid again (the script above sets data-solid once the banner scrolls away). */
	:global(html.js) .site-header[data-overlay]:not([data-solid]) {
		background: transparent;
		border-bottom-color: rgb(243 241 243 / 0.2);
		color: var(--mineral);
	}

	/* While the menu is open the header joins it as one Espresso surface,
	   including over the home banner, and the page behind stops scrolling */
	.site-header:has(.menu[open]),
	:global(html.js) .site-header[data-overlay]:has(.menu[open]) {
		background: var(--espresso);
		color: var(--mineral);
		border-bottom-color: var(--espresso);
	}

	:global(html:has(.menu[open])) {
		overflow: hidden;
	}
</style>
