---
import Wordmark from './logos/Wordmark.astro';
import Monogram from './logos/Monogram.astro';
import { getSettings, getProducts } from '../lib/content';

const settings = await getSettings();
const products = await getProducts();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const left = [
	{ href: '/#system', label: 'Shop' },
	{ href: '/story', label: 'Our Story' },
	{ href: '/mission', label: 'Mission' },
];
const right = [
	{ href: '/faq', label: 'FAQ' },
	{ href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => href === path;
---

<div class="announce bg-espresso on-dark">
	<ul class="wrap label">
		{settings.announcements.map((message) => <li>{message}</li>)}
	</ul>
</div>

<header class="site-header">
	<div class="wrap bar">
		<nav class="nav nav--left" aria-label="Primary">
			<a href="/" class="mono-link" aria-label="Elyon home">
				<Monogram class="monogram" />
			</a>
			{left.map((item) => (
				<a class="label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<a href="/" class="brand" aria-label="Elyon home">
			<Wordmark class="wordmark" />
		</a>

		<nav class="nav nav--right" aria-label="Secondary">
			{right.map((item) => (
				<a class="label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<details class="menu">
			<summary class="label">
				<span class="menu-open">Menu</span>
				<span class="menu-close">Close</span>
			</summary>
			<div class="menu-panel bg-espresso on-dark">
				<ul>
					{[...left, ...right].map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
				<ul class="menu-products label">
					{products.map((p) => (
						<li><a href={`/products/${p.slug}`}>{p.name}</a></li>
					))}
				</ul>
			</div>
		</details>
	</div>
</header>

<script>
	// Close the mobile menu after following an in-page link.
	document.querySelectorAll<HTMLAnchorElement>('.menu-panel a').forEach((link) => {
		link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
	});
</script>

<style>
	.announce ul {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		margin: 0 auto;
		padding-block: 0.6rem;
		list-style: none;
		font-size: 0.625rem;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}

	.bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 4.5rem;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2.25rem);
	}

	.nav--right {
		justify-content: flex-end;
	}

	.nav a {
		text-decoration: none;
		padding-block: 0.4rem;
		border-bottom: 1px solid transparent;
	}

	.nav a.label:hover,
	.nav a[aria-current='page'] {
		border-bottom-color: currentColor;
	}

	:global(.monogram) {
		width: 1.6rem;
		height: auto;
	}

	:global(.wordmark) {
		width: clamp(7rem, 11vw, 9.5rem);
		height: auto;
	}

	.menu {
		display: none;
	}

	@media (max-width: 860px) {
		.announce li:not(:first-child) {
			display: none;
		}

		.announce ul {
			justify-content: center;
		}

		.bar {
			grid-template-columns: auto 1fr auto;
		}

		.nav a.label,
		.nav--right {
			display: none;
		}

		.brand {
			justify-self: center;
		}

		.menu {
			display: block;
			justify-self: end;
		}

		.menu summary {
			list-style: none;
			cursor: pointer;
			padding: 0.75rem 0;
		}

		.menu summary::-webkit-details-marker {
			display: none;
		}

		.menu-close,
		.menu[open] .menu-open {
			display: none;
		}

		.menu[open] .menu-close {
			display: inline;
		}

		.menu-panel {
			position: fixed;
			inset: 4.5rem 0 0 0;
			padding: 2.5rem var(--gutter);
			display: grid;
			align-content: start;
			gap: 3rem;
			overflow-y: auto;
		}

		.menu-panel ul {
			margin: 0;
			padding: 0;
			list-style: none;
			display: grid;
			gap: 1.1rem;
		}

		.menu-panel ul:first-child a {
			font-size: 2rem;
			text-transform: uppercase;
			letter-spacing: -0.01em;
			text-decoration: none;
		}

		.menu-products {
			border-top: 1px solid var(--rule);
			padding-top: 2rem !important;
		}

		.menu-products a {
			text-decoration: none;
		}
	}
</style>
